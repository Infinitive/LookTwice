---
import '../styles/global.css';
const {
  title = 'LookTwice',
  description = 'A living record of attention, memory, objects, and the present tense.'
} = Astro.props;
const path = Astro.url.pathname;
const links = [['Story','/story/'],['Notes','/notes/'],['Things','/things/'],['Now','/now/']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#efe6d7" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="LookTwice home">LOOK<span>TWICE</span></a>
      <nav aria-label="Primary navigation">
        {links.map(([label, href]) => <a class:list={{ active: path.startsWith(href) }} href={href}>{label}</a>)}
      </nav>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer">
      <span>LookTwice</span>
      <span>Look around if it interests you.</span>
    </footer>
  </body>
</html>
