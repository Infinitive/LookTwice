---
import '../styles/global.css';
const {
  title = 'LookTwice',
  description = 'A living record of attention, memory, objects, and the present tense.',
  image = '/social-card.svg',
  type = 'website'
} = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const socialImage = new URL(image, Astro.site);
const links = [['Story','/story/'],['Notes','/notes/'],['Things','/things/'],['Now','/now/']];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#efe6d7" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="LookTwice Notes" href="/rss.xml" />
  <meta property="og:site_name" content="LookTwice" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={socialImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImage} />
  <title>{title}</title>
</head>
<body>
  <a class="skip-link" href="#content">Skip to content</a>
  <header class="site-header">
    <a class="wordmark" href="/" aria-label="LookTwice home">LOOK<span>TWICE</span></a>
    <nav aria-label="Primary navigation">
      {links.map(([label, href]) => <a class:list={{ active: path.startsWith(href) }} href={href}>{label}</a>)}
    </nav>
  </header>
  <main id="content"><slot /></main>
  <footer class="site-footer">
    <div><strong>LookTwice</strong><p>A living record, not a finished portrait.</p></div>
    <div class="contact-links" aria-label="Contact links">
      <a href="mailto:johnathan@looktwice.cc" aria-label="Email Johnathan at johnathan@looktwice.cc">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 5h18v14H3V5Zm2 2v.4l7 5.2 7-5.2V7H5Zm14 10V9.9l-7 5.1-7-5.1V17h14Z"/></svg>
        <span>johnathan@looktwice.cc</span>
      </a>
      <a href="https://github.com/Infinitive" target="_blank" rel="me noopener noreferrer" aria-label="Infinitive on GitHub, opens in a new tab">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 .7a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.3c-3.4.7-4.1-1.4-4.1-1.4-.5-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2A11.4 11.4 0 0 1 12 6.3c1 0 2 .1 3 .4 2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .7Z"/></svg>
        <span>GitHub / Infinitive ↗</span>
      </a>
    </div>
  </footer>
</body>
</html>
