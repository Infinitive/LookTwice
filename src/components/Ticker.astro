---
const words='STORY • NOTES • THINGS • NOW • RECORDS • RECIPES • ROOMS • ROADS • FILMS • THRIFT STORES • SCHOOL • HOME • ORDINARY LIFE •';
---
<div class="ticker full-bleed" data-ticker><div class="ticker-track" aria-label="Themes in LookTwice"><span>{words}</span><span aria-hidden="true">{words}</span></div><button class="ticker-toggle" type="button" aria-pressed="false">Pause</button></div><script>const ticker=document.querySelector('[data-ticker]');const button=ticker?.querySelector('button');button?.addEventListener('click',()=>{const paused=ticker?.classList.toggle('is-paused')??false;button.setAttribute('aria-pressed',String(paused));button.textContent=paused?'Play':'Pause'});</script>
